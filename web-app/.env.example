# Porta e bind della console (default: solo localhost, come il servizio TTS)
PORT=3000
HOST=127.0.0.1
# Host consentiti come target del proxy (separati da virgola)
ALLOWED_HOSTS=127.0.0.1,localhost
# true = consenti qualsiasi host http/https (endpoint generici, anche cloud: i dati escono dalla macchina)
ALLOW_ANY_HOST=false
# Timeout verso il servizio TTS (ms)
TIMEOUT_MS=120000
