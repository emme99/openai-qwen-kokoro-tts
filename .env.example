# --- Generici ---
TTS_ENGINE=qwen            # qwen | kokoro
HOST=127.0.0.1
PORT=5050
PRELOAD=true
DEFAULT_LANGUAGE=it
VOICE_IT=alloy             # nomi LOGICI dal registro (voices.toml)
VOICE_EN=ash
MAX_INPUT_CHARS=2000
VOICES_REGISTRY=voices.toml

# --- Qwen3-TTS ---
DEVICE=mps                 # mps | cpu | cuda
DTYPE=float32              # NON usare float16 (rotto su questo modello)
MODEL_PATH=./models/Qwen/Qwen3-TTS-12Hz-0.6B-Base
FLASH_ATTN=false

# --- Kokoro-82M (onnx, CPU) ---
# int8 di default (~2x più veloce su CPU); per fp32: ./models/kokoro-v1.0.onnx
KOKORO_MODEL_PATH=./models/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=./models/voices-v1.0.bin
